      "x": -500,
      "y": 0,
      "portIp0": "10.100.0.2/24",
      "staticRoutes": [
        { "dest": "0.0.0.0/0", "nextHop": "10.100.0.1" }
      ]
    },
    {
      "id": 2,
      "label": "Leaf-1",
      "type": "ROUTER",
      "x": -250,
      "y": 0,
      "portIp0": "10.100.0.1/24",
